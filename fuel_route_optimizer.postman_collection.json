    "name": "Spotter Fuel Route Optimizer API",
    "description": "Collection of all API endpoints and input types for the Spotter Fuel Route Optimizer service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
