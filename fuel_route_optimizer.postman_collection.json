      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Optimize Route - POST (City Names)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_location\": \"Dallas, TX\",\n  \"finish_location\": \"Chicago, IL\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/optimize-route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "optimize-route",
            ""
          ]
        },
        "description": "Calculate optimal fuel stops using city/state string names."
      }
    },
    {
      "name": "2. Optimize Route - POST (Coordinate Pairs)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin_latitude\": 32.7767,\n  \"origin_longitude\": -96.7970,\n  \"destination_latitude\": 41.8781,\n  \"destination_longitude\": -87.6298\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/optimize-route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "optimize-route",
            ""
          ]
        },
        "description": "Calculate optimal fuel stops directly using GPS latitude and longitude pairs."
      }
    },
    {
      "name": "3. Optimize Route - POST (Short Aliases 'start' and 'finish')",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Houston, TX\",\n  \"finish\": \"Atlanta, GA\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/optimize-route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "optimize-route",
            ""
          ]
        },
        "description": "Calculate optimal fuel stops using short alias field names 'start' and 'finish'."
      }
    },
    {
      "name": "4. Optimize Route - POST (Mixed: City Name + Coordinates)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_location\": \"Los Angeles, CA\",\n  \"destination_latitude\": 36.1699,\n  \"destination_longitude\": -115.1398\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/optimize-route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "optimize-route",
            ""
          ]
        },
        "description": "Calculate optimal fuel stops using a mixed input format (origin city + destination coordinates)."
      }
    },
    {
      "name": "5. Optimize Route - GET (City Names Query Params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/optimize-route/?start_location=Dallas, TX&finish_location=Chicago, IL",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "optimize-route",
            ""
          ],
          "query": [
            {
              "key": "start_location",
              "value": "Dallas, TX"
            },
            {
              "key": "finish_location",
              "value": "Chicago, IL"
            }
          ]
        },
        "description": "Calculate optimal fuel stops via GET request using query parameters."
      }
    },
